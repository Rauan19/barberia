# Conexao do PostgreSQL (Neon).
# Use o endpoint com "-pooler" no host: e ele que aguenta varias funcoes ao mesmo tempo.
# connect_timeout da folga para o Neon acordar do modo suspenso (leva ~2s).
DATABASE_URL="postgresql://user:senha@host-pooler.regiao.aws.neon.tech/neondb?sslmode=require&connect_timeout=15&pool_timeout=20"

# Chave que assina o cookie de sessao. Gere uma propria para producao:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="troque-por-uma-string-aleatoria-longa"
